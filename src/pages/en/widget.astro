---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/pflegegeld-rechner/?lang=en" title="German care allowance and benefits 2026" width="100%" height="1000" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/pflegeheim-rechner/?lang=en" title="German care home co-payment by state" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the German Care Allowance or Care Home Calculator" description="Embed the 2026 German care allowance calculator or the care home co-payment calculator for all 16 states free of charge by iframe: copy the code, no account, no cookies." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a care calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For expat associations, support groups and international community sites in Germany: copy once and the amounts update themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Care allowance and benefits by care grade</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Care home co-payment by state</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p>Terms: the source link below the calculator stays visible, the calculator is not altered and it is provided without warranty. Remove <code>?lang=en</code> for the German version.</p>
    <p>What your readers type stays on their device; the frame stores and measures nothing. Questions via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/pflegegeld-rechner/?lang=en" title="German care allowance and benefits 2026" width="100%" height="1000" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
